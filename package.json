{
  "name": "spectre-react-lib",
  "version": "0.6.2",
  "description": "Spectre.css and React integration",
  "author": "Philip Van Raalte",
  "license": "MIT",
  "keywords": [
    "react",
    "spectre",
    "ui"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/FIL1994/spectre-react-lib"
  },
  "bugs": {
    "url": "https://github.com/FIL1994/spectre-react-lib/issues"
  },
  "homepage": "https://github.com/FIL1994/spectre-react-lib#readme",
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --project tsconfig.build.json",
    "dev": "bun run storybook",
    "format": "vp fmt --config .oxfmtrc.json --write .",
    "format:check": "vp fmt --config .oxfmtrc.json --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tsc": "tsc --noEmit",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "lint": "vp lint --config .oxlintrc.json src .storybook --deny-warnings",
    "audit": "bun audit --audit-level moderate",
    "prepare": "lefthook install",
    "ci": "bun run format:check && bun run lint && bun run tsc && bun run test && bun run build && bun run build-storybook && bun run audit",
    "release:help": "bunx release-please --help",
    "release:beta": "bunx release-please release-pr --prerelease-type beta --repo-url FIL1994/spectre-react-lib --token $GITHUB_TOKEN",
    "release:bootstrap": "bunx release-please bootstrap --prerelease --repo-url FIL1994/spectre-react-lib --token $GITHUB_TOKEN --initial-version 0.4.5 --release-type node --bump-minor-pre-major --bump-patch-for-minor-pre-major"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "happy-dom": "^20.10.6",
    "lefthook": "^2.1.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "spectre.css": "^0.5.9",
    "storybook": "^10.5.0",
    "tiny-invariant": "^1.3.3",
    "ts-essentials": "^10.2.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  }
}
